<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8">
  <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0" name="viewport">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="<%= config.description || theme.description %>">
  <meta name="keyword" content="<%= config.keyword || theme.keyword %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <meta property="og:title" content="<%= page.title %> | <%= config.title %>" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="<%= config.language %>" />
  <meta property="og:description" content="<%= page.description %>" />
  <meta property="og:image" content="<%= page.thumbnail || " http://catcoding.me/css/images/logo.png " %>" />
  <link rel="alternate" type="application/rss+xml" title="<%= config.title %>; Feed" href="https://catcoding.me/atom.xml" />

  <script>
    (function() {
      try {
        localStorage.removeItem('catcoding-theme');
      } catch (e) {}
      var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      var theme = prefersDark ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme;
    })();
  </script>
  <%- css(['css/plugins/gitment.css', 'css/plugins/fonts.css', 'css/plugins/code.css', 'css/plugins/prism.css', 'css/plugins/font-awesome.min.css']) %>
  <link rel="stylesheet" href="/css/style.css?v=20260526-project-compact">
  <%- js(['js/qrious', 'js/gitment', 'js/jquery.min', 'js/geopattern.min.js', 'js/nprogress.min.js']) %>

  <% if (config.favicon || theme.favicon){ %>
  <link rel="shortcut icon" type="image/ico" href="<%= config.favicon || theme.favicon %>" />
  <% } else { %>
  <%- favicon_tag('css/images/favicon.ico') %>
  <% } %>
  <title>
    <% if (page.title){ %>
    <%= page.title %> |
    <%= config.title %>
    <% } else { %>
    <%= config.title %>
    <% } %>
  </title>

  <div style='margin:0 auto;width:0px;height:0px;overflow:hidden;'>
    <img src="/css/images/logo.png" width='400px' height='400px' />
  </div>

  <%- partial('_third-party/mathjax') %>

<script defer src="https://cloud.umami.is/script.js" data-website-id="9767b9c8-6554-4673-af8c-2d22e00617aa"></script>
</head>
