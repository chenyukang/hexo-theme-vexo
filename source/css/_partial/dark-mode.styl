html[data-theme="dark"]
  background: #0f1412
  color-scheme: dark
  body
    background: #0f1412
    color: #d8e4dc
  a
    color: #66d89d
  .article-head > a,
  .article-summary,
  .page-arrow,
  .nav-arrow
    color: #d8e4dc
  .article-date,
  .copyright,
  .menu-link,
  .notice,
  .markdown-content .image-caption
    color: #9aaca3
  .home-slogan
    color: #d8e4dc
    background: #14231c
    border-color: #2b4a39
  .search-body
    background: #111915
    border: 1px solid #26342d
    border-radius: 6px
    box-shadow: 0 10px 30px rgba(0, 0, 0, .22)
    box-sizing: border-box
    padding: 24px
  .search-body .gsc-control-cse,
  .search-body .gsc-control-cse .gsc-table-result,
  .search-body .gsc-results-wrapper-overlay,
  .search-body .gsc-results
    background: transparent
    border-color: #26342d
  .search-body .gsc-control-cse
    border: 0
    padding: 0
  .search-body form.gsc-search-box,
  .search-body table.gsc-search-box
    margin: 0
  .search-body table.gsc-search-box td.gsc-input
    padding-right: 10px
  .search-body td.gsc-search-button
    display: table-cell !important
  .search-body .gsc-input-box,
  .search-body .gsc-input-box-hover,
  .search-body .gsc-input-box-focus
    background: #0f1412
    border-color: #3b5146
    border-radius: 5px
    box-shadow: none
    height: 46px
  .search-body .gsib_a
    padding: 0 12px
  .search-body input.gsc-input,
  .search-body .gsc-input-box input
    background-color: #0f1412 !important
    background-image: none !important
    color: #d8e4dc !important
    caret-color: #66d89d
    font-size: 16px !important
    height: 24px !important
    margin: 0 !important
  .search-body input.gsc-input::placeholder,
  .search-body .gsib_a,
  .search-body .gscb_a
    color: #9aaca3 !important
  .search-body .gsc-search-button-v2
    background-color: #209460
    border-color: #209460
    border-radius: 4px
    display: inline-flex !important
    align-items: center
    justify-content: center
    min-width: 52px
    height: 46px
    padding: 0 16px
  .search-body .gsc-search-button-v2:hover
    background-color: #27b173
    border-color: #27b173
  .search-body .gsc-search-button-v2 svg
    display: block
    fill: #fff
    width: 16px
    height: 16px
  .search-body .gsc-webResult.gsc-result,
  .search-body .gsc-result,
  .search-body .gsc-expansionArea,
  .search-body .gcsc-find-more-on-google
    background: #111915
    border-color: #26342d
  .search-body .gsc-webResult.gsc-result:hover
    background: #17211c
    border-color: rgba(102, 216, 157, .3)
  .search-body .gsc-above-wrapper-area,
  .search-body .gsc-resultsHeader,
  .search-body .gsc-tabsArea
    border-color: #26342d
  .search-body .gsc-result-info,
  .search-body .gs-snippet,
  .search-body .gsc-orderby-label,
  .search-body .gsc-selected-option,
  .search-body .gsc-option-menu-item,
  .search-body .gcsc-find-more-on-google-text
    color: #aec3b8
  .search-body .gs-title,
  .search-body .gs-title b,
  .search-body .gsc-cursor-page,
  .search-body .gcsc-find-more-on-google
    color: #66d89d !important
  .search-body .gs-visibleUrl,
  .search-body .gs-visibleUrl-short
    color: #9fd1b8 !important
  .search-body .gsc-option-menu,
  .search-body .gsc-completion-container
    background: #111915
    border-color: #26342d
    color: #d8e4dc
  .time-section .section-year
    color: #d8e4dc
  .time-section .section-list .section-list-item .archive-title
    color: #b8d7c8
    &:hover
      color: #66d89d
  .time-section .section-list .section-list-item .archive-date
    color: #9aaca3
  .fixed-header
    background-color: rgba(17, 23, 20, .96)
    box-shadow: 0 0 3px rgba(0, 0, 0, .55)
    .item-link,
    .theme-toggle
      color: #d8e4dc
    .home-link,
    .theme-toggle:hover
      color: #66d89d
    .menu .icon-bar
      background-color: #9aaca3
  .menu-mask
    background: rgba(17, 23, 20, .98)
  .menu-item:after,
  .markdown-content h3,
  .qrcode,
  .app-footer,
  .nav-container,
  .catalog-container .toc-main
    border-color: #26342d
  .app-footer,
  .author
    background-color: #0f1412
  .gitment-container,
  .gitment-markdown
    color: #d8e4dc
  .gitment-container .gitment-spinner-icon
    fill: #d8e4dc
  a.gitment-header-issue-link,
  a.gitment-header-issue-link:visited,
  a.gitment-comment-name,
  a.gitment-comment-name:visited,
  a.gitment-editor-logout-link,
  a.gitment-editor-logout-link:visited,
  a.gitment-editor-footer-tip,
  .gitment-comment-header,
  .gitment-editor-tab,
  .gitment-comments-empty,
  .gitment-comments-error,
  .gitment-comments-loading
    color: #9aaca3
  .gitment-container a,
  .gitment-container a:visited,
  .gitment-markdown a
    color: #66d89d
  .gitment-comment-main,
  .gitment-editor-main
    background: #111915
    border-color: #26342d
  .gitment-editor-main::before,
  .gitment-comment-main::before
    border-right-color: #26342d
  .gitment-editor-main::after,
  .gitment-comment-main::after
    border-right-color: #111915
  .gitment-comment-header,
  .gitment-editor-header,
  .gitment-editor-footer,
  .gitment-comment-body,
  .gitment-editor-preview
    background: #111915
  .gitment-editor-header
    border-bottom-color: #26342d
  .gitment-editor-tab.gitment-selected
    background: #17211c
    border-color: #26342d
    color: #d8e4dc
  .gitment-editor-body textarea,
  .gitment-editor-body textarea:focus
    background-color: #111915
    color: #d8e4dc
    caret-color: #66d89d
  .gitment-editor-body textarea::placeholder
    color: #6d7f75
  .gitment-comment-body-folded::before
    background: linear-gradient(180deg, rgba(17, 25, 21, 0), rgba(17, 25, 21, .95))
  .gitment-comment-body-folded::after
    background: rgba(17, 25, 21, .95)
    color: #9aaca3
  .gitment-comments-page-item
    border-color: #26342d
    color: #d8e4dc
  .gitment-comments-page-item:hover,
  .gitment-comments-page-item.gitment-selected
    background-color: #17211c
  .gitment-markdown h1,
  .gitment-markdown h2
    border-bottom-color: #26342d
  .gitment-markdown h6,
  .gitment-markdown blockquote
    color: #9aaca3
  .gitment-markdown blockquote
    border-left-color: #26342d
  .gitment-markdown hr
    background-color: #26342d
    border-bottom-color: #26342d
  .gitment-markdown table th,
  .gitment-markdown table td
    border-color: #26342d
  .gitment-markdown table tr
    background-color: #111915
    border-top-color: #26342d
  .gitment-markdown table tr:nth-child(2n)
    background-color: #18251f
  .gitment-markdown img
    background-color: #111915
  .gitment-markdown kbd
    background-color: #17211c
    border-color: #26342d
    border-bottom-color: #26342d
    box-shadow: inset 0 -1px 0 #26342d
    color: #d8e4dc
  .gitment-markdown .pl-c
    color: #83958b
  .gitment-markdown .pl-c1,
  .gitment-markdown .pl-s .pl-v,
  .gitment-markdown .pl-mq
    color: #7cc7ff
  .gitment-markdown .pl-e,
  .gitment-markdown .pl-en,
  .gitment-markdown .pl-mdr
    color: #c79cff
  .gitment-markdown .pl-smi,
  .gitment-markdown .pl-s .pl-s1,
  .gitment-markdown .pl-mi,
  .gitment-markdown .pl-mb
    color: #d8e4dc
  .gitment-markdown .pl-ent,
  .gitment-markdown .pl-sr .pl-cce,
  .gitment-markdown .pl-mi1
    color: #8ee6a6
  .gitment-markdown .pl-k,
  .gitment-markdown .pl-md,
  .gitment-markdown .pl-bu
    color: #ff7b88
  .gitment-markdown .pl-s,
  .gitment-markdown .pl-pds,
  .gitment-markdown .pl-s .pl-pse .pl-s1,
  .gitment-markdown .pl-sr,
  .gitment-markdown .pl-sr .pl-sre,
  .gitment-markdown .pl-sr .pl-sra,
  .gitment-markdown .pl-corl
    color: #8ee6a6
  .gitment-markdown .pl-v,
  .gitment-markdown .pl-smw,
  .gitment-markdown .pl-mc,
  .gitment-markdown .pl-ml,
  .gitment-markdown .pl-mo
    color: #ffb36b
  .gitment-markdown .pl-md
    background-color: rgba(255, 123, 136, .12)
  .gitment-markdown .pl-mi1
    background-color: rgba(142, 230, 166, .12)
  .gitment-markdown .pl-mc
    background-color: rgba(255, 179, 107, .12)
  .tag-code,
  .markdown-content blockquote
    background: #17211c
    color: #d8e4dc
  .markdown-content p code,
  .article-summary p code,
  .gitment-markdown code
    background-color: #1d2a23
    color: #cfe9dc
    border: 1px solid #26342d
  .markdown-content pre,
  .article-summary pre,
  .gitment-markdown pre,
  .gitment-markdown .highlight pre,
  pre[class*="language-"],
  code[class*="language-"],
  .hljs
    background: #111915
    color: #d8e4dc
    text-shadow: none
  .markdown-content pre,
  .article-summary pre,
  .gitment-markdown pre,
  .gitment-markdown .highlight pre,
  pre[class*="language-"],
  .hljs
    border: 1px solid #26342d
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .03)
  .markdown-content pre code,
  .article-summary pre code,
  .gitment-markdown pre code,
  pre[class*="language-"] code
    background: transparent
    border: 0
    color: inherit
  :not(pre) > code[class*="language-"]
    background: #1d2a23
    color: #cfe9dc
    border: 1px solid #26342d
    text-shadow: none
  .markdown-content figure,
  .article-summary figure
    background: #111915
    border: 1px solid #26342d
  .markdown-content figure:after,
  .article-summary figure:after
    background: rgba(17, 25, 21, .78)
    color: #9aaca3
  .markdown-content figure figcaption,
  .article-summary figure figcaption
    color: #66d89d
  .line-numbers .line-numbers-rows
    border-right-color: #26342d
  .line-numbers-rows > span:before
    color: #6d7f75
  .token.comment,
  .token.prolog,
  .token.doctype,
  .token.cdata,
  .hljs-comment,
  .hljs-meta,
  .hljs-meta .hljs-keyword
    color: #83958b
  .token.punctuation,
  .token.operator,
  .token.entity,
  .token.url,
  .token.variable,
  .hljs-subst,
  .hljs-variable,
  .hljs-template-tag,
  .hljs-template-variable
    color: #d8e4dc
  .token.property,
  .token.tag,
  .token.constant,
  .token.symbol,
  .token.deleted,
  .hljs-number,
  .hljs-symbol,
  .hljs-literal,
  .hljs-deletion,
  .hljs-link
    color: #ff7b88
  .token.boolean,
  .token.number
    color: #c79cff
  .token.selector,
  .token.attr-name,
  .token.string,
  .token.char,
  .token.builtin,
  .token.inserted,
  .hljs-string,
  .hljs-doctag,
  .hljs-addition,
  .hljs-regexp,
  .hljs-selector-attr,
  .hljs-selector-pseudo
    color: #8ee6a6
  .token.atrule,
  .token.attr-value,
  .token.function,
  .token.class-name,
  .hljs-title,
  .hljs-name
    color: #f2d78c
  .token.keyword,
  .hljs-keyword,
  .hljs-selector-tag,
  .hljs-bullet,
  .hljs-tag
    color: #7cc7ff
  .token.important,
  .token.regex,
  .hljs-type,
  .hljs-built_in,
  .hljs-builtin-name,
  .hljs-quote,
  .hljs-section,
  .hljs-selector-class
    color: #ffb36b
  .markdown-content > table tbody tr:nth-child(even)
    background: #18251f
  .markdown-content > table tbody tr:nth-child(odd)
    background: #111915
  .card-container .project-card .card-wrap
    color: #cfe9dc
    background-color: #111915
    border-color: #26342d
  .card-container .project-card .card-wrap .card-title
    color: #cfe9dc
  .card-container .project-card .card-wrap .card-description
    color: #aec3b8
  .card-container .project-card .card-wrap .card-footer
    color: #9fd1b8
  .card-container .project-card .card-wrap .card-footer span .fa
    color: #66d89d
  .card-container .project-card .card-wrap:hover
    border-color: rgba(102, 216, 157, .35)
    box-shadow: 0 1px 3px rgba(0, 0, 0, .35), 0 4px 12px rgba(0, 0, 0, .28)
  .card-container .project-card .card-wrap:hover .card-title
    color: #66d89d
  .time-section .section-year:before,
  .wrap-active
    background-color: #0f1412
  .image-view-wrap.wrap-active
    background-color: rgba(0, 0, 0, .92)
