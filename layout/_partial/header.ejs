<header class="header fixed-header">
  <div class="header-container">
    <a class="home-link" href="<%- url_for() %>">
      <div class="logo"></div>
      <span><%- config.title %></span>
    </a>
    <ul class="right-list">
      <% for(name in theme.menu) { %>
        <li class="list-item">
          <% if (url_for(theme.menu[name]) == '/' + path.replace('/index.html', '') || (url_for(theme.menu[name]) == '/' && is_home())) { %>
            <a href="<%- url_for(theme.menu[name]) %>" class="item-link active"><%- name %></a>
          <% } else { %>
            <a href="<%- url_for(theme.menu[name]) %>" class="item-link"><%- name %></a>
          <% } %>
        </li>
      <% } %>

        <li class="list-item" style="margin: 0">
       <a class="icon-small" href="/search">
        <span class="fa-stack fa-lg">
          <i class="fa fa-search fa-stack-1x fa-inverse" style="color:#8ccb8c"></i>
        </span>
       </a>
      </li>

       <li class="list-item" style="margin-left: 3px">
        <a class="icon-small" href="/atom.xml">
         <span class="fa-stack fa-lg">
           <i class="fa fa-rss fa-inverse" style="color:orange"></i>
         </span>
        </a>
       </li>

       <li class="list-item theme-toggle-item">
        <button class="icon-small theme-toggle" type="button" aria-label="切换暗黑模式" title="切换暗黑模式">
          <span class="fa-stack fa-lg">
            <i class="fa fa-adjust fa-stack-1x fa-inverse" aria-hidden="true"></i>
          </span>
        </button>
       </li>
    </ul>

    <button class="icon-small theme-toggle theme-toggle-mobile" type="button" aria-label="切换暗黑模式" title="切换暗黑模式">
      <span class="fa-stack fa-lg">
        <i class="fa fa-adjust fa-stack-1x fa-inverse" aria-hidden="true"></i>
      </span>
    </button>

    <div class="menu">
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </div>
    <div class="menu-mask">
      <ul class="menu-list">
        <% for(name in theme.menu) { %>
          <li class="menu-item">
            <% if (url_for(theme.menu[name]) == '/' + path.replace('/index.html', '') || (url_for(theme.menu[name]) == '/' && is_home())) { %>
              <a href="<%- url_for(theme.menu[name]) %>" class="menu-link mobile-active"><%- name %></a>
            <% } else { %>
              <a href="<%- url_for(theme.menu[name]) %>" class="menu-link"><%- name %></a>
            <% } %>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</header>
