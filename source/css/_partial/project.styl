.project-app
  max-width: 1180px
  min-width: 300px
  padding: 3em 24px
  @media m-mobile
    padding: 2em 14px

.project-showcase
  width: 100%
  margin: 0 auto

.project-showcase + .project-showcase
  margin-top: 54px
  padding-top: 42px
  border-top: 1px solid rgba(52, 73, 94, .12)

.project-showcase-head
  display: flex
  align-items: flex-end
  justify-content: space-between
  gap: 24px
  margin: 0 0 24px
  h3
    margin: 0
    color: color-dark
    font-size: 1.45em
    line-height: 1.2
  @media m-mobile
    align-items: flex-start
    flex-direction: column
    gap: 12px

.project-eyebrow
  margin: 0 0 6px
  color: color-gray
  font-family: 'Lato', sans-serif
  font-size: .72em
  font-weight: 700
  text-transform: uppercase

.project-github-link
  display: inline-flex
  align-items: center
  gap: 8px
  height: 38px
  padding: 0 14px
  border: 1px solid color-border
  border-radius: 6px
  color: color-dark
  font-family: 'Lato', sans-serif
  font-weight: 700
  line-height: 38px
  white-space: nowrap
  transition: border-color .18s ease, color .18s ease, transform .18s ease
  &:hover
    color: color-primary
    border-color: rgba(32, 148, 96, .35)
    transform: translateY(-1px)

.card-container.project-grid
  width: 100%
  margin: 0 auto
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 24px
  justify-content: stretch
  @media screen and (max-width: 960px)
    grid-template-columns: repeat(2, minmax(0, 1fr))
    gap: 20px
  @media screen and (max-width: 660px)
    grid-template-columns: 1fr
    gap: 16px

.card-container.project-grid .project-card
  min-width: 0
  min-height: 260px
  position: relative

.card-container.project-grid .project-card--featured
  grid-column: span 2
  @media screen and (max-width: 960px)
    grid-column: span 1

.card-container.project-grid.project-grid--featured
  grid-template-columns: minmax(0, 1.18fr) repeat(2, minmax(0, 1fr))
  @media screen and (max-width: 960px)
    grid-template-columns: repeat(2, minmax(0, 1fr))
  @media screen and (max-width: 660px)
    grid-template-columns: 1fr

.card-container.project-grid.project-grid--featured .project-card
  min-height: 260px

.card-container.project-grid.project-grid--featured .project-card--featured
  grid-column: auto
  grid-row: auto
  min-height: 260px

.card-container.project-grid .project-card .card-wrap
  box-sizing: border-box
  height: 100%
  display: flex
  flex-direction: column
  position: relative
  overflow: hidden
  padding: 70px 22px 20px
  border: 1px solid color-border
  border-radius: 6px
  background: color-white
  color: color-dark
  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease
  &:hover
    border-color: rgba(32, 148, 96, .28)
    box-shadow: 0 10px 28px rgba(52, 73, 94, .13)
    transform: translateY(-3px)

.card-container.project-grid .project-card .card-header
  position: absolute
  width: 100%
  height: 44px
  top: 0
  left: 0
  border-top-left-radius: 6px
  border-top-right-radius: 6px

.card-container.project-grid .project-card--featured .card-header
  height: 54px

.card-container.project-grid .project-card--featured .card-wrap
  padding-top: 82px

.card-title-row
  display: flex
  align-items: center
  justify-content: space-between
  gap: 12px

.card-container.project-grid .project-card .card-title
  min-width: 0
  margin: 0
  color: color-dark
  font-size: 1.22em
  line-height: 1.25
  overflow-wrap: anywhere

.project-badge
  flex: 0 0 auto
  padding: 2px 8px
  border-radius: 999px
  background: rgba(32, 148, 96, .1)
  color: color-primary
  font-family: 'Lato', sans-serif
  font-size: .62em
  font-weight: 700
  line-height: 1.6
  text-transform: uppercase

.card-container.project-grid .project-card .card-description
  margin: 12px 0 0
  color: #536575
  font-size: .9em
  line-height: 1.55
  text-align: left
  display: -webkit-box
  -webkit-line-clamp: 3
  -webkit-box-orient: vertical
  overflow: hidden

.card-main
  min-height: 112px

.card-topics
  display: flex
  flex-wrap: wrap
  gap: 8px
  min-height: 26px
  margin-top: auto
  padding-top: 12px
  span
    max-width: 100%
    padding: 2px 8px
    border: 1px solid rgba(32, 148, 96, .15)
    border-radius: 999px
    color: color-primary
    font-family: 'Lato', sans-serif
    font-size: .68em
    line-height: 1.5
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap

.card-container.project-grid .project-card .card-footer
  display: flex
  flex-wrap: wrap
  gap: 10px 16px
  box-sizing: border-box
  width: 100%
  margin-top: 14px
  color: color-gray
  font-family: 'Lato', sans-serif
  font-size: .82em
  span
    display: inline-flex
    align-items: center
    gap: 6px
    line-height: 1.4
  .fa
    color: color-primary

.project-language b
  display: inline-block
  width: 9px
  height: 9px
  border-radius: 50%
